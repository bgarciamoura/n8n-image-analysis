# Copie para .env e ajuste. O .env está no .gitignore - nunca versione.

# --- Postgres (banco do n8n) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=n8n

# --- n8n ---
# Versão da imagem (ex.: 1.90.2). "latest" pega a mais recente.
N8N_VERSION=latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# URL pública usada nos links do Form Trigger/webhooks (termine com /).
# Se expor via túnel (ngrok, cloudflared), coloque a URL do túnel aqui.
WEBHOOK_URL=http://localhost:5678/
# Chave que criptografa as credenciais salvas. Gere com:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=gere-uma-chave-com-openssl-rand-hex-32

# --- Fuso horário ---
TZ=America/Sao_Paulo
